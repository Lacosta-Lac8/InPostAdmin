@{ ViewData["Title"] = "Home"; }

<main class="content">
    <section class="welcome-section">
        <h1>Packaging catalog</h1>
        <p>Select your dimensions for editing through the system.</p>
    </section>

    <section class="inventory-grid">
        <article class="inventory-item">
            <div class="item-icon">A</div>
            <h3>Small Box</h3>
            <p>80 x 380 x 640 mm</p>
            <span class="price">16.99 PLN</span>
        </article>
        <article class="inventory-item">
            <div class="item-icon">B</div>
            <h3>Medium Box</h3>
            <p>190 x 380 x 640 mm</p>
            <span class="price">21.99 PLN</span>
        </article>
        <article class="inventory-item">
            <div class="item-icon">C</div>
            <h3>Large Box</h3>
            <p>410 x 380 x 640 mm</p>
            <span class="price">28.99 PLN</span>
        </article>
    </section>
</main>